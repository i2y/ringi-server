{
  "openapi": "3.1.0",
  "info": {
    "title": "ringi-server: the framework's own operations",
    "version": "1"
  },
  "x-ringi-server": "The operations of the framework, which no package's openapi.json has: the administration's, the attachments', and the list of a kind's requests. The server serves them merged with its packages' at GET /openapi.json",
  "paths": {
    "/admin/kinds": {
      "get": {
        "operationId": "admin_list_kinds",
        "tags": [
          "administration"
        ],
        "summary": "The kinds with a version the person may switch",
        "responses": {
          "200": {
            "description": "The kinds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/admin.kinds"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/framework.unsigned"
          },
          "500": {
            "$ref": "#/components/responses/framework.failed"
          }
        }
      }
    },
    "/admin/kinds/{kind}/versions/{version}": {
      "post": {
        "operationId": "admin_switch_kind",
        "tags": [
          "administration"
        ],
        "summary": "Decide when a version starts",
        "parameters": [
          {
            "$ref": "#/components/parameters/admin.kind"
          },
          {
            "$ref": "#/components/parameters/admin.version"
          },
          {
            "$ref": "#/components/parameters/framework.key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/admin.switch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Switched: the record (null when nothing changed) and the kind",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/admin.switched"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/framework.unsigned"
          },
          "500": {
            "$ref": "#/components/responses/framework.failed"
          },
          "400": {
            "$ref": "#/components/responses/framework.bad"
          },
          "403": {
            "$ref": "#/components/responses/framework.cross_site"
          },
          "413": {
            "$ref": "#/components/responses/framework.too_large"
          },
          "415": {
            "$ref": "#/components/responses/framework.media_type"
          },
          "404": {
            "$ref": "#/components/responses/framework.not_found"
          },
          "409": {
            "$ref": "#/components/responses/framework.refused"
          }
        }
      }
    },
    "/admin/organization": {
      "get": {
        "operationId": "admin_get_organization",
        "tags": [
          "administration"
        ],
        "summary": "The latest snapshot of the organization in short",
        "responses": {
          "200": {
            "description": "The organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/admin.organization"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/framework.unsigned"
          },
          "500": {
            "$ref": "#/components/responses/framework.failed"
          },
          "404": {
            "$ref": "#/components/responses/framework.not_found"
          }
        }
      }
    },
    "/admin/organization/drafts": {
      "post": {
        "operationId": "admin_check_organization",
        "tags": [
          "administration"
        ],
        "summary": "Read the organization's data from the source or an upload, check it, and keep it as a draft",
        "parameters": [
          {
            "$ref": "#/components/parameters/framework.key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/admin.check"
              }
            },
            "application/zip": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The draft and its difference from the latest snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/admin.draft"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/framework.unsigned"
          },
          "500": {
            "$ref": "#/components/responses/framework.failed"
          },
          "400": {
            "description": "A body that does not read, or data that does not pass its checks",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/framework.problems"
                    },
                    {
                      "$ref": "#/components/schemas/framework.error"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/framework.cross_site"
          },
          "413": {
            "$ref": "#/components/responses/framework.too_large"
          },
          "415": {
            "$ref": "#/components/responses/framework.media_type"
          },
          "404": {
            "$ref": "#/components/responses/framework.not_found"
          },
          "429": {
            "$ref": "#/components/responses/framework.too_many"
          }
        }
      }
    },
    "/admin/organization/drafts/{id}": {
      "get": {
        "operationId": "admin_get_draft",
        "tags": [
          "administration"
        ],
        "summary": "A draft of the person's, with its difference from the latest snapshot now",
        "parameters": [
          {
            "$ref": "#/components/parameters/admin.draft"
          }
        ],
        "responses": {
          "200": {
            "description": "The draft",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/admin.draft"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/framework.unsigned"
          },
          "500": {
            "$ref": "#/components/responses/framework.failed"
          },
          "404": {
            "$ref": "#/components/responses/framework.not_found"
          }
        }
      }
    },
    "/admin/organization/imports": {
      "post": {
        "operationId": "admin_import_organization",
        "tags": [
          "administration"
        ],
        "summary": "Import a draft",
        "parameters": [
          {
            "$ref": "#/components/parameters/framework.key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/admin.import"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Imported: the record (null when nothing changed) and the organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/admin.imported"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/framework.unsigned"
          },
          "500": {
            "$ref": "#/components/responses/framework.failed"
          },
          "400": {
            "$ref": "#/components/responses/framework.bad"
          },
          "403": {
            "$ref": "#/components/responses/framework.cross_site"
          },
          "413": {
            "$ref": "#/components/responses/framework.too_large"
          },
          "415": {
            "$ref": "#/components/responses/framework.media_type"
          },
          "404": {
            "$ref": "#/components/responses/framework.not_found"
          },
          "409": {
            "$ref": "#/components/responses/framework.refused"
          },
          "429": {
            "$ref": "#/components/responses/framework.too_many"
          }
        }
      }
    },
    "/admin/records": {
      "get": {
        "operationId": "admin_list_records",
        "tags": [
          "administration"
        ],
        "summary": "A page of the record, the newest first",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "the first day, YYYY-MM-DD",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "the last day, YYYY-MM-DD",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "description": "a kind of request",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "what",
            "in": "query",
            "required": false,
            "description": "move, kind or organization",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "person",
            "in": "query",
            "required": false,
            "description": "who did it",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ticket",
            "in": "query",
            "required": false,
            "description": "a ticket",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "the ID of the line the page goes on after",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "how many lines: 1 to 100 (50 if not given)",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The lines, and whether more follow",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/admin.records"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/framework.unsigned"
          },
          "500": {
            "$ref": "#/components/responses/framework.failed"
          },
          "400": {
            "$ref": "#/components/responses/framework.bad"
          }
        }
      }
    },
    "/admin/records.csv": {
      "get": {
        "operationId": "admin_records_csv",
        "tags": [
          "administration"
        ],
        "summary": "The same lines as CSV; Link names the next part",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "the first day, YYYY-MM-DD",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "the last day, YYYY-MM-DD",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "description": "a kind of request",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "what",
            "in": "query",
            "required": false,
            "description": "move, kind or organization",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "person",
            "in": "query",
            "required": false,
            "description": "who did it",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ticket",
            "in": "query",
            "required": false,
            "description": "a ticket",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "the ID of the line the page goes on after",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The lines as CSV",
            "headers": {
              "Link": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/framework.unsigned"
          },
          "500": {
            "$ref": "#/components/responses/framework.failed"
          },
          "400": {
            "$ref": "#/components/responses/framework.bad"
          }
        }
      }
    },
    "/files": {
      "post": {
        "operationId": "upload_file",
        "tags": [
          "files"
        ],
        "summary": "Keep a file to attach to a request",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The file kept",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/file.kept"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/framework.unsigned"
          },
          "500": {
            "$ref": "#/components/responses/framework.failed"
          },
          "400": {
            "$ref": "#/components/responses/framework.bad"
          },
          "403": {
            "$ref": "#/components/responses/framework.cross_site"
          },
          "413": {
            "$ref": "#/components/responses/framework.too_large"
          },
          "415": {
            "$ref": "#/components/responses/framework.media_type"
          },
          "404": {
            "$ref": "#/components/responses/framework.not_found"
          },
          "429": {
            "$ref": "#/components/responses/framework.too_many"
          }
        }
      }
    },
    "/files/{id}": {
      "get": {
        "operationId": "get_own_file",
        "tags": [
          "files"
        ],
        "summary": "A file the person kept, before a request holds it",
        "parameters": [
          {
            "$ref": "#/components/parameters/file.id"
          }
        ],
        "responses": {
          "200": {
            "description": "The file",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/framework.unsigned"
          },
          "500": {
            "$ref": "#/components/responses/framework.failed"
          },
          "404": {
            "$ref": "#/components/responses/framework.not_found"
          }
        }
      }
    },
    "/tickets": {
      "get": {
        "operationId": "list_tickets",
        "tags": [
          "tickets"
        ],
        "summary": "The requests of a kind the person sees for the kind: the tickets of the versions of the kind whose tickets the gate lets them see whoever is on them (see, asked of the version with no ticket), each one they may see, the newest first, by when they were made, and the larger ID first (the later one) where that is the same. A person the gate lets see none of them gets an empty list",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": true,
            "description": "The kind of request, by its name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Keeps the tickets of one status; all when it is left out",
            "schema": {
              "type": "string",
              "enum": [
                "in_progress",
                "paused",
                "with_requester",
                "approved",
                "rejected",
                "withdrawn",
                "expired"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "How many tickets: 1 to 100 (50 if not given)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "The ID of the last ticket of the page before: the page goes on after it",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The tickets, in that order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/tickets.page"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/framework.bad"
          },
          "401": {
            "$ref": "#/components/responses/framework.unsigned"
          },
          "500": {
            "$ref": "#/components/responses/framework.failed"
          }
        }
      }
    },
    "/tickets/{ticket}/files/{id}": {
      "get": {
        "operationId": "get_ticket_file",
        "tags": [
          "files"
        ],
        "summary": "A file a ticket holds, to a person who may see the ticket",
        "parameters": [
          {
            "$ref": "#/components/parameters/file.ticket"
          },
          {
            "$ref": "#/components/parameters/file.id"
          }
        ],
        "responses": {
          "200": {
            "description": "The file",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/framework.unsigned"
          },
          "500": {
            "$ref": "#/components/responses/framework.failed"
          },
          "404": {
            "$ref": "#/components/responses/framework.not_found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "framework.error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "An operation not carried out, and why"
      },
      "framework.refused": {
        "type": "object",
        "required": [
          "refused",
          "text",
          "text_ja",
          "at"
        ],
        "properties": {
          "refused": {
            "type": "string",
            "enum": [
              "stale",
              "owner",
              "locks_out"
            ]
          },
          "text": {
            "type": "string"
          },
          "text_ja": {
            "type": "string"
          },
          "at": {
            "type": "null"
          }
        },
        "additionalProperties": false,
        "description": "An operation refused by the state: what changed since it was asked, in English and in Japanese"
      },
      "framework.problems": {
        "type": "object",
        "required": [
          "error",
          "problems",
          "more",
          "stopped"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "at",
                "text",
                "text_ja"
              ],
              "properties": {
                "at": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "text_ja": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "more": {
            "type": "integer"
          },
          "stopped": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "description": "The organization's data that does not pass its checks: the first 100 problems, each at its file and line, how many more there are, and whether the checks stopped at 1,000"
      },
      "admin.record_brief": {
        "type": "object",
        "required": [
          "id",
          "at",
          "person",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "at": {
            "type": "integer"
          },
          "person": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "admin.start": {
        "type": "object",
        "required": [
          "how",
          "at",
          "day",
          "number",
          "record"
        ],
        "properties": {
          "how": {
            "type": "string",
            "enum": [
              "description",
              "now",
              "day",
              "never"
            ]
          },
          "at": {
            "type": [
              "integer",
              "null"
            ]
          },
          "day": {
            "type": [
              "string",
              "null"
            ]
          },
          "number": {
            "type": "integer"
          },
          "record": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/admin.record_brief"
              }
            ]
          }
        },
        "additionalProperties": false,
        "description": "When a version starts: as its description says, from a time, from a day, or never; at and day are null where it has none. number counts the switches"
      },
      "admin.version": {
        "type": "object",
        "required": [
          "version",
          "owner",
          "effective_from",
          "usable",
          "may_switch",
          "may_read",
          "start",
          "tickets"
        ],
        "properties": {
          "version": {
            "type": "integer"
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "effective_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "usable": {
            "type": "object",
            "required": [
              "from",
              "through"
            ],
            "properties": {
              "from": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "through": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "may_switch": {
            "type": "boolean"
          },
          "may_read": {
            "type": "boolean"
          },
          "start": {
            "$ref": "#/components/schemas/admin.start"
          },
          "tickets": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "open",
                  "all"
                ],
                "properties": {
                  "open": {
                    "type": "integer"
                  },
                  "all": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "admin.kind": {
        "type": "object",
        "required": [
          "name",
          "title",
          "owner",
          "current",
          "versions"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "current": {
            "type": [
              "integer",
              "null"
            ]
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/admin.version"
            }
          }
        },
        "additionalProperties": false
      },
      "admin.kinds": {
        "type": "object",
        "required": [
          "kinds"
        ],
        "properties": {
          "kinds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/admin.kind"
            }
          }
        },
        "additionalProperties": false
